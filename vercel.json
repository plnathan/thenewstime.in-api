{
  "functions": {
    "api/index.ts": {
      "includeFiles": "assets/watermark-fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/system/cloudinary-cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
